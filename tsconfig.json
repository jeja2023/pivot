{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "noImplicitAny": false,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": "."
  },
  "include": [
    "types/**/*",
    "client/src/**/*",
    "desktop/stealth-policy.js",
    "server/services/agent-browser-profile-cleanup.js",
    "server/services/agent-event-batch-writer.js",
    "server/services/host-classifier.js"
  ],
  "exclude": [
    "node_modules",
    "data"
  ]
}
