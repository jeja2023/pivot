{
  "name": "pivot",
  "version": "0.0.216",
  "description": "智枢 Pivot - AI 智能中枢管理系统",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "chcp 65001 >nul && node server/index.js",
    "dev": "chcp 65001 >nul && nodemon --ignore client server/index.js",
    "lint": "eslint . --ext .js",
    "check:text": "node scripts/check_text_integrity.js",
    "check:standards": "node scripts/check_development_standards.js",
    "check:external": "node scripts/check_external_links.js",
    "audit:policy": "node scripts/check_audit_policy.js",
    "check:safe-html": "node scripts/check_safe_html_usage.js",
    "hooks:install": "node scripts/install_git_hooks.js",
    "version:sync": "node scripts/sync_version.js",
    "check": "npm run check:text && npm run check:standards && node scripts/check_syntax.js && node scripts/check_chat_assets.js && npm run check:safe-html && npm run check:window-globals && npm run check:e2e-smoke",
    "test": "npm run check && npm run lint && node tests/security.test.js",
    "verify": "npm test",
    "backup": "node scripts/backup_db.js",
    "desktop": "node scripts/run_desktop.js",
    "pack:win": "node scripts/package_desktop.js --dir",
    "dist:win": "node scripts/package_desktop.js nsis",
    "desktop:icon": "node scripts/build_desktop_icon.js",
    "check:window-globals": "node scripts/check_window_globals_usage.js",
    "check:e2e-smoke": "node scripts/check_e2e_smoke.js",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.js"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.4-r.1",
    "@e965/xlsx": "^0.20.3",
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.16.0",
    "mssql": "^11.0.1",
    "multer": "^2.1.1",
    "mysql2": "^3.14.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.34.5",
    "uuid": "^11.1.1",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.3.0",
    "nodemon": "^3.1.0"
  },
  "build": {
    "appId": "com.pivot.desktop",
    "productName": "Pivot",
    "directories": {
      "output": "dist-electron-remote"
    },
    "files": [
      "desktop/**",
      "server/**",
      "client/**",
      "scripts/**",
      "package.json",
      "package-lock.json",
      "README.md",
      "使用帮助.md",
      "node_modules/**",
      "!data/**",
      "!uploads/**",
      "!logs/**",
      "!.env",
      "!.git/**",
      "!.github/**",
      "!tests/**"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/@duckdb/**",
      "node_modules/sharp/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "config.json",
        "to": "config.json"
      },
      {
        "from": "config.example.json",
        "to": "config.example.json"
      },
      {
        "from": "docs/远程模式部署说明.md",
        "to": "docs/远程模式部署说明.md"
      }
    ],
    "nodeGypRebuild": false,
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.example.com/pivot/"
      }
    ]
  }
}
