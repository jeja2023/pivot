{
  "name": "pivot",
  "version": "0.0.76",
  "description": "智枢 Pivot - AI 智能中枢管理系统",
  "main": "server/index.js",
  "scripts": {
    "start": "chcp 65001 >nul && node server/index.js",
    "dev": "chcp 65001 >nul && nodemon --ignore client server/index.js",
    "lint": "eslint . --ext .js",
    "check:text": "node scripts/check_text_integrity.js",
    "version:sync": "node scripts/sync_version.js",
    "check": "npm run check:text && node scripts/check_syntax.js && node scripts/check_chat_assets.js",
    "test": "npm run check && npm run lint && node tests/security.test.js",
    "verify": "npm test",
    "backup": "node scripts/backup_db.js"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.16.0",
    "mssql": "^11.0.1",
    "multer": "^2.1.1",
    "mysql2": "^3.14.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.34.5",
    "uuid": "^9.0.1",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "eslint": "^10.3.0",
    "nodemon": "^3.1.0"
  }
}
