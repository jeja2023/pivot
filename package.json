{
  "name": "pivot",
  "version": "0.1.55",
  "description": "智枢 Pivot - AI 智能中枢管理系统",
  "author": {
    "name": "jeja2023",
    "email": "jeja2023@github.com"
  },
  "homepage": "https://github.com/jeja2023/pivot",
  "license": "UNLICENSED",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon --ignore client server/index.js",
    "lint": "eslint .",
    "check:text": "node scripts/check_text_integrity.js",
    "check:large-files": "node scripts/check_large_files.js",
    "check:architecture": "node scripts/check_architecture_boundaries.js",
    "check:governance": "node scripts/check_governance_metrics.js",
    "report:governance": "node scripts/check_governance_metrics.js --report",
    "check:standards": "node scripts/check_development_standards.js && node scripts/check_no_new_raw_sql.js",
    "check:external": "node scripts/check_external_links.js",
    "check:no-new-raw-sql": "node scripts/check_no_new_raw_sql.js",
    "audit:policy": "node scripts/check_audit_policy.js",
    "check:safe-html": "node scripts/check_safe_html_usage.js",
    "check:async_db_calls": "node scripts/check_async_db_calls.js",
    "hooks:install": "node scripts/install_git_hooks.js",
    "version:sync": "node scripts/sync_version.js",
    "check": "npm run check:text && npm run check:desktop:linux && npm run check:large-files && npm run check:architecture && npm run check:governance && npm run check:standards && node scripts/check_syntax.js && node scripts/check_chat_assets.js && npm run check:safe-html && npm run check:async_db_calls && npm run check:window-globals && npm run check:e2e-smoke",
    "test:all": "node scripts/run_node_tests.js",
    "test:agent:quality": "node scripts/run_node_tests.js tests/provider-usage-calibration.test.js tests/agent-non-idempotent-fault-matrix.test.js tests/agent-residency-multiprocess.test.js",
    "test:mcp:official": "npx --no-install @modelcontextprotocol/conformance client --command \"node scripts/mcp-conformance-client.js\" --scenario initialize --spec-version 2025-11-25",
    "test:mcp:official:tools": "npx --no-install @modelcontextprotocol/conformance client --command \"node scripts/mcp-conformance-client.js\" --scenario tools_call --spec-version 2025-11-25",
    "test:mcp:official:sse": "npx --no-install @modelcontextprotocol/conformance client --command \"node scripts/mcp-conformance-client.js\" --scenario sse-retry --spec-version 2025-11-25",
    "test": "npm run check && npm run lint && npm run test:all",
    "verify": "npm test",
    "backup": "node scripts/backup_db.js",
    "desktop": "node scripts/run_desktop.js",
    "pack:win": "node scripts/package_desktop.js --dir",
    "dist:win": "node scripts/package_desktop.js nsis",
    "check:desktop:linux": "node scripts/check_desktop_build.js",
    "dist:linux": "node scripts/package_desktop.js deb --x64",
    "dist:linux:x64": "node scripts/package_desktop.js deb --x64",
    "dist:linux:arm64": "node scripts/package_desktop.js deb --arm64",
    "dist:linux:appimage:x64": "node scripts/package_desktop.js AppImage --x64",
    "dist:linux:appimage:arm64": "node scripts/package_desktop.js AppImage --arm64",
    "dist:arm64": "npm run dist:linux:arm64",
    "dist:loong64": "node scripts/reject_unsupported_desktop_target.js loong64",
    "desktop:icon": "node scripts/build_desktop_icon.js",
    "check:window-globals": "node scripts/check_window_globals_usage.js",
    "check:e2e-smoke": "node scripts/check_e2e_smoke.js",
    "test:e2e": "node scripts/run_e2e_tests.js"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.4-r.1",
    "@e965/xlsx": "^0.20.3",
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "js-yaml": "^4.3.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.16.0",
    "mssql": "^11.0.1",
    "multer": "^2.1.1",
    "mysql2": "^3.14.1",
    "parse5": "^6.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.3",
    "unzipper": "^0.12.5",
    "uuid": "^11.1.1",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/conformance": "0.2.0-alpha.11",
    "@playwright/test": "^1.61.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "nodemon": "^3.1.0"
  },
  "build": {
    "appId": "com.pivot.desktop",
    "productName": "Pivot",
    "directories": {
      "output": "dist-electron-remote"
    },
    "files": [
      "desktop/**",
      "server/**",
      "client/**",
      "!client/*.exe",
      "scripts/**",
      "package.json",
      "package-lock.json",
      "README.md",
      "使用帮助.md",
      "node_modules/**",
      "!data/**",
      "!uploads/**",
      "!logs/**",
      "!.env",
      "!.git/**",
      "!.github/**",
      "!tests/**"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/@duckdb/**",
      "node_modules/sharp/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/icon.ico"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "client/android-chrome-512x512.png",
      "category": "Utility",
      "synopsis": "智枢 Pivot 企业智能协同客户端",
      "description": "连接组织内部 Pivot 服务的桌面客户端，提供智能协同、数据分析、知识库和自动化工作台。"
    },
    "deb": {
      "priority": "optional",
      "packageCategory": "utils"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "config.json",
        "to": "config.json"
      },
      {
        "from": "config.example.json",
        "to": "config.example.json"
      },
      {
        "from": "docs/远程模式部署说明.md",
        "to": "docs/远程模式部署说明.md"
      },
      {
        "from": "artifacts/agent-browser-pack",
        "to": "agent-runtime/browser"
      },
      {
        "from": "artifacts/agent-python-pack",
        "to": "agent-runtime/python"
      }
    ],
    "extraFiles": [
      {
        "from": "config.json",
        "to": "config.json"
      }
    ],
    "nodeGypRebuild": false,
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.example.com/pivot/"
      }
    ]
  }
}
