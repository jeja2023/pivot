# 智枢 (Pivot AI) 环境变量配置示例
# 注意：生产环境请复制此文件为 .env 并修改关键密钥

# --- 基础运行配置 ---
# 运行环境：production (生产) / development (开发)
NODE_ENV=production

# --- 数据库配置 (PostgreSQL) ---
# PostgreSQL 数据库连接串（支持 host.docker.internal / 容器服务名 / 局域网 IP）
DATABASE_URL=postgresql://pivot:pivot123456@localhost:5432/pivot

# 连接池上限。注意：每个 API 请求都要经过鉴权中间件查一次 users 表，也就是每个请求
# 都要占用一个池连接。默认 10 对多人同时使用的正式环境偏小——管理员打开设置页会并发
# 发出十余个统计请求，一旦把池占满，其他页面的请求也会一起拿不到连接。
# 建议：并发用户数 × 2，且不超过 PostgreSQL 的 max_connections 的一半。
PG_POOL_MAX=30

# 单条 SQL 最长执行时间。默认 60000 比前端 30 秒超时还长，意味着一条慢查询可以把
# 一个池连接锁住到前端已经报错之后。设为小于前端超时的值，能让慢查询提前失败并归还连接。
PG_STATEMENT_TIMEOUT_MS=20000

# 从池中获取连接的最长等待时间（池满时的排队上限）
PG_CONNECT_TIMEOUT_MS=5000

# 空闲连接回收时间
PG_IDLE_TIMEOUT_MS=30000

# --- 运行时保护与可观测性 ---
# 接口悬挂兜底：/api、/v1 的 GET 请求处理超过该毫秒数且尚未开始写响应时，
# 主动返回 503 SERVER_BUSY_TIMEOUT，并把事件循环延迟、连接池水位写进日志。
# 必须小于前端的 30000ms 超时，否则前端会先超时、服务端现场也就丢了。设为 0 关闭。
API_REQUEST_WATCHDOG_MS=20000

# 运行时压力采样间隔（事件循环延迟 / 连接池水位 / 在途请求 / 堆占用）
RUNTIME_DIAGNOSTICS_INTERVAL_MS=60000

# 事件循环延迟 p99 超过该毫秒数即判定为 degraded 并告警（同步阻塞或 GC 抖动的信号）
RUNTIME_LOOP_DELAY_WARN_MS=500

# 堆占用超过该比例即判定为 degraded（接近上限时 V8 会持续 Full GC，表现为全站变慢）
RUNTIME_HEAP_WARN_RATIO=0.85

# 上游模型流式响应的空闲超时。注意 axios 的 timeout 只覆盖「发出请求到收到响应头」，
# 不覆盖流体传输：上游发完头就静默挂住时，并发许可与客户端 socket 会被永久持有，
# 只能靠重启进程释放。该值是「多久没收到任何字节就中止上游」。设为 0 关闭（不建议）。
MODEL_STREAM_IDLE_TIMEOUT_MS=120000

# libuv 线程池大小。文件系统操作与 DNS 解析共用这个线程池，默认只有 4 个线程：
# 文档解析、目录扫描或出站 DNS 变慢时会把线程池占满，连纯内存接口都会被拖住。
# 该变量必须在进程启动前设置（Dockerfile / 启动脚本），运行中修改无效。
UV_THREADPOOL_SIZE=16

# 容器时区设定（解决 Docker 容器日志与宿主机东八区相差 8 小时的问题）
TZ=Asia/Shanghai

# 服务运行端口
PORT=3000

# 系统公网访问地址 (可选)，用于生成绝对路径链接，例如: https://ai.example.com
PUBLIC_URL=

# 跨域白名单，多个地址用英文逗号分隔；同源部署可留空
CORS_ORIGIN=

# 受信任的反向代理 IP/CIDR 列表。仅当直连来源命中该列表时，才会信任并使用 X-Forwarded-For。
TRUSTED_PROXY_IPS=

# 数据目录。Docker 生产环境建议挂载到 /app/data；本地可留空使用项目内 data 目录。
DATA_DIR=

# 日志级别：error (错误), warn (警告), info (信息), debug (调试)
LOG_LEVEL=info

# --- 性能与缓存优化 ---
# 记忆压缩 Token 阈值 (推荐设置为模型上下文的 70%)
# 仅作为初始化默认值；后续可由管理员在系统设置中调整，保存后即时生效。
MEMORY_THRESHOLD=204800
# 自动压缩最少可归档消息数；默认 1，适合单条长输入超过阈值时触发
MEMORY_MIN_MESSAGES_TO_COMPRESS=1
# 压缩后保留最近活跃消息数量
MEMORY_SUMMARY_KEEP_COUNT=6
# 记忆压缩请求超时（毫秒）
MEMORY_COMPRESSION_TIMEOUT_MS=180000
# 记忆压缩全局并发上限
MEMORY_COMPRESSION_MAX_CONCURRENT=2

# 响应压缩开关；流式聊天接口不会被压缩
ENABLE_COMPRESSION=true

# 静态资源缓存时间 (Browser Cache)
STATIC_MAX_AGE=1d
# 第三方库静态资源缓存时间 (Vendor Cache)
VENDOR_STATIC_MAX_AGE=30d

# 数据概览目录体积统计缓存时间 (单位: 毫秒)，避免频繁扫描大附件目录
DIR_SIZE_CACHE_MS=60000

# 审计日志保留天数。生产环境建议按合规要求设置，默认 180 天
AUDIT_LOG_RETENTION_DAYS=180
# API 调用日志保留天数
API_CALL_LOG_RETENTION_DAYS=180
# 软删除附件、知识库文件和消息文件的物理清理保留天数
STORAGE_GC_RETENTION_DAYS=90
# 单次存储清理批量上限
STORAGE_GC_BATCH_SIZE=200
# 后台维护任务在服务启动后延迟多久再开始，单位毫秒；0 表示立即开始
MAINTENANCE_START_DELAY_MS=10000

# --- 数据库备份与维护配置 ---
# pg_dump 可执行文件名或绝对路径（留空时会自动查找系统 PATH 及 Windows 常见安装目录）
PG_DUMP_BIN=pg_dump
# 备份导出的 Schema，默认为 public
DB_BACKUP_SCHEMA=public
# 备份文件保留天数与保留的最大历史版本数（超出将自动轮转清理）
DB_BACKUP_RETENTION_DAYS=7
DB_BACKUP_MAX_VERSIONS=7
# 数据库备份目录；留空使用 DATA_DIR/backups
DB_BACKUP_DIR=
# pg_dump 超时时间 (单位: 毫秒，默认 15 分钟)
PG_DUMP_TIMEOUT_MS=900000

# --- 并发与监控 ---
# Prometheus 指标接口访问令牌。留空表示局域网内直接开放 /api/metrics；设置后需使用 Authorization: Bearer <token>
METRICS_TOKEN=
# 仅在指标无法使用令牌且处于完全可信与隔离的局域网时设置为 true。
METRICS_ALLOW_UNAUTHENTICATED_LAN=false
# 缓存高开销的已鉴权健康诊断结果，以避免重复的磁盘和数据库探测。
HEALTH_DETAIL_CACHE_TTL_MS=10000

# 系统允许的最大 AI 并发请求数
MAX_CONCURRENT_AI_REQUESTS=2
# AI 请求排队队列的最大长度
MAX_AI_QUEUE_SIZE=20
# 空闲 SSE 心跳包间隔时间（毫秒）；设置为 0 表示关闭心跳
SSE_HEARTBEAT_MS=15000
# 队列中请求的超时时间 (单位: 毫秒)
AI_QUEUE_TIMEOUT_MS=300000

# 单个模型端点的默认并发上限；模型配置中填写 0 时使用该值
MODEL_ENDPOINT_DEFAULT_CONCURRENCY=2
# 单个模型端点的排队队列最大长度
MODEL_ENDPOINT_QUEUE_SIZE=20
MODEL_ENDPOINT_QUEUE_TIMEOUT_MS=300000
# 单个模型端点连续失败达到该次数后进入短暂熔断
MODEL_ENDPOINT_FAILURE_THRESHOLD=3
# 模型端点熔断持续时间 (单位: 毫秒)
MODEL_ENDPOINT_CIRCUIT_OPEN_MS=60000
# 模型端点健康监控间隔与单次探测超时 (单位: 毫秒)
MODEL_ENDPOINT_MONITOR_INTERVAL_MS=30000
MODEL_ENDPOINT_MONITOR_TIMEOUT_MS=5000
# 数据概览识别模型端点本地性的 DNS 查询超时时间（毫秒）；生产网络 DNS 异常时避免监控接口悬挂
PIVOT_DNS_LOOKUP_TIMEOUT_MS=2000

# 是否给自部署 Qwen3/QwQ 下发 chat_template_kwargs.enable_thinking=false 关闭思考模式（1 开启，0 关闭）
# 思考 tokens 与正式答案共用 max_tokens 预算，不关闭会导致后台批处理结果被截断并整批重试
MODEL_THINKING_TEMPLATE_KWARGS=1

# --- 数据分析全量语义分析 ---
# 全量语义分析后台 worker 轮询间隔（毫秒）
DATA_ANALYSIS_SEMANTIC_WORKER_INTERVAL_MS=10000
# 任务运行锁超过该分钟数后可被其他 worker 恢复
DATA_ANALYSIS_SEMANTIC_STALE_LOCK_MINUTES=30
# 单个任务最多自动重试次数
DATA_ANALYSIS_SEMANTIC_MAX_ATTEMPTS=3
# 单批最多文本分块数，避免模型输出预算不足以逐条返回结果
DATA_ANALYSIS_SEMANTIC_MAX_SEGMENTS=30
# 同一全量任务同时处理的批次数；实际并发同时受全局 MAX_CONCURRENT_AI_REQUESTS 与模型端点并发上限收窄
DATA_ANALYSIS_SEMANTIC_BATCH_CONCURRENCY=2
# 批次并发的可配置上限，DATA_ANALYSIS_SEMANTIC_BATCH_CONCURRENCY 不会超过该值
DATA_ANALYSIS_SEMANTIC_MAX_BATCH_CONCURRENCY=8
# 单个批次请求的超时时间（毫秒）；批次要一次产出数十条结论，慢端点下不宜沿用 3 分钟通用超时
DATA_ANALYSIS_SEMANTIC_REQUEST_TIMEOUT_MS=300000

# --- 长期记忆配置 ---
# 长期记忆模型抽取单次超时时间（毫秒，默认 15000ms；模型响应较慢时可调大为 30000ms）
LONG_TERM_MEMORY_LLM_EXTRACTION_TIMEOUT_MS=15000
# 长期记忆模型抽取单次最大输出 Token 数，避免模型生成过长导致超时
LONG_TERM_MEMORY_LLM_EXTRACTION_MAX_TOKENS=800
# 模型抽取超时后的按模型熔断冷却时间（毫秒），冷却期间直接使用启发式规则
LONG_TERM_MEMORY_LLM_FAILURE_COOLDOWN_MS=120000
# 是否启用大模型提取长期记忆（true = 模型提取 + 规则兜底；false = 仅纯规则提取，节省模型推理资源）
LONG_TERM_MEMORY_LLM_EXTRACTION=true
# 长期记忆后台任务并发数
LONG_TERM_MEMORY_EXTRACTION_MAX_CONCURRENT=2

# --- 智能体运行治理 ---
# 智能体任务最大并发数
AGENT_MAX_CONCURRENT_RUNS=2
# 是否允许聊天选择 Agent 执行模式：1 允许，0 禁止；普通回答模式始终可用
CHAT_AGENT_EXECUTION_ENABLED=1
# DAG 工作流中互不依赖节点的最大并发执行数
AGENT_DAG_NODE_CONCURRENCY=4
# 显式保留思维链的 Agent 调用最低输出预算；思考本身要吃掉上千 tokens，预算不足会让正文为空
AGENT_THINKING_MIN_MAX_TOKENS=12288
# Agent 最终答案与规划步骤的最低输出预算；面向用户的完整回复沿用 1200 兜底会被直接截断
AGENT_ANSWER_MIN_MAX_TOKENS=16384
# 工作流 HTTP 节点只保存下面这类变量的后缀引用，不把真实凭据写进工作流 JSON。
# 示例：节点填写 credentialSecret=CRM_API 时，运行时读取此变量。
PIVOT_WORKFLOW_SECRET_CRM_API=
# 单个智能体任务最大运行时长（毫秒）
AGENT_RUN_TIMEOUT_MS=600000
# 单次智能体工具调用最大时长（毫秒）
AGENT_TOOL_TIMEOUT_MS=120000
# 模型未配置上下文窗口时的 Agent 回退窗口（Token）
AGENT_CONTEXT_WINDOW_TOKENS=32768
# 服务重启后，超过该分钟数无心跳的运行中任务会被标记为异常
AGENT_STALE_RUNNING_MINUTES=30
# 启用流式 function calling（v0.0.49）：true = 智能体先走 OpenAI tools 流式协议
# 流式失败、未授权工具或步数耗尽时会自动回退到旧的回合制 JSON 协议；预算/超时会保留部分结果
AGENT_STREAMING_TOOLS=true
# 单个智能体任务的全局默认最大 Token 预算（默认 500000；达到上限后保留部分结果并停止继续调用）
AGENT_TASK_MAX_TOKENS_TOTAL=500000
# Agent 沙箱 stdout + stderr 合计最大缓存字节数（默认 10MB，超出即终止子进程）
PIVOT_AGENT_SANDBOX_MAX_OUTPUT_BYTES=10485760
# Agent 数据适配器 JSON 文件大小上限
AGENT_DATA_MAX_JSON_BYTES=67108864
# 管理员用户 CSV 导入最大行数
ADMIN_USER_IMPORT_MAX_ROWS=10000

# --- Agent 技能治理与文档交付（落地方案 v1.2）---
# 企业多租户访问开关。false（默认）= 单租户部署，共享技能使用默认租户 organizations.id=1；
# true = 企业多租户部署，用户未归属任何组织时租户不可解析，共享查询、发布与下载令牌一律拒绝，
# 绝不回落到其他组织。缺失等同 false。
PIVOT_ENTERPRISE_ACCESS=false
# 工具策略执行点（PEP）模式。enforce（默认）= 默认拒绝立即生效；
# shadow = 影子模式，只记录「默认拒绝改造会新增哪些拒绝」而不改变放行结果，用于上线前评估影响面。
# 缺失或非法值一律按 enforce 处理（fail-closed）。
PIVOT_AGENT_PEP_MODE=enforce
# 技能灰度分桶的租户级 HMAC 密钥。留空时回退到 DATA_ENCRYPTION_KEY / JWT_SECRET，
# 使桶位在同一部署内稳定且不可被外部预测；轮换只影响新建 release。
PIVOT_SKILL_ROLLOUT_SECRET=
# 技能包是否强制要求有效数字签名。true（默认）= 未签名或验签失败即拒绝创建版本。
AGENT_SKILL_REQUIRE_SIGNATURE=true
# 技能签名的受信公钥（PEM）。为空时任何签名都无法通过校验，等同于禁止导入已签名技能。
AGENT_SKILL_PUBLIC_KEY=
# 允许技能声明的能力白名单（逗号分隔）。留空表示不额外收窄，能力仍须在平台能力注册表中登记。
AGENT_SKILL_ALLOWED_PERMISSIONS=
# 技能包内容寻址安装根目录。留空使用 DATA_DIR/agent-skills。
AGENT_SKILL_ROOT=
# 二进制产物 CAS 根目录。留空使用 DATA_DIR/agent-artifact-objects。
PIVOT_ARTIFACT_CAS_DIR=
# 单个渲染产物字节上限（默认 64MB），超出即拒绝渲染。
PIVOT_ARTIFACT_MAX_BYTES=67108864
# CJK 字体目录。PDF 渲染依赖该目录下的 OFL 授权字体；自检失败时 PDF 能力显式下线并告警。
PIVOT_PDF_FONT_DIR=
# PDF 正文字体文件名与其 SHA-256 校验值；校验失败即下线 PDF 能力，不输出乱码。
PIVOT_PDF_FONT_FILE=NotoSansSC-VF.ttf
PIVOT_PDF_FONT_SHA256=763146584cf0710223441356b4395e279021b0806c196614377a7a0174ae074a
# 产物下载令牌有效期（秒，默认 300）与交付意图有效期（秒，默认 900）。
PIVOT_ARTIFACT_DOWNLOAD_TOKEN_TTL_SECONDS=300
PIVOT_ARTIFACT_DELIVERY_TTL_SECONDS=900
# 本机交付领取租约时长（秒，默认 60）与最大尝试次数（默认 3）。
PIVOT_ARTIFACT_DELIVERY_LEASE_SECONDS=60
PIVOT_ARTIFACT_DELIVERY_MAX_ATTEMPTS=3
# 本机写入目录授权有效期上限（天，默认 30）与单次写入体积上限（字节，默认 64MB）。
PIVOT_LOCAL_OUTPUT_GRANT_MAX_DAYS=30
PIVOT_LOCAL_OUTPUT_MAX_BYTES=67108864
# 本机写入单设备单日配额（字节，默认 1GB），防止把交付通路当作磁盘填充通路。
PIVOT_LOCAL_OUTPUT_DAILY_QUOTA_BYTES=1073741824
# 可执行 Capability Package Worker。默认关闭；开启前必须登记内网不可变 image@sha256 镜像与固定入口命令。
# Worker 不申请 GPU，且以无网络、只读根文件系统、无业务凭据的 Docker 容器运行。
PIVOT_CAPABILITY_WORKER_ENABLED=false
PIVOT_CAPABILITY_WORKER_DOCKER=docker

# --- PostgreSQL 高频写入队列 ---
# 队列刷新间隔（毫秒）；达到 80% 高水位时自动加速到最多 50ms
PIVOT_DB_WRITE_FLUSH_MS=250
# 默认单批写入行数
PIVOT_DB_WRITE_BATCH_SIZE=100
# 高水位期间允许的最大批量行数，仍受 PostgreSQL 65535 参数上限约束
PIVOT_DB_WRITE_MAX_BATCH_SIZE=1000
# 单次队列写入的客户端保护超时；超时连接会被销毁并按退避策略重试
PIVOT_DB_WRITE_QUERY_TIMEOUT_MS=15000
# 各类写入队列容量
PIVOT_DB_AUDIT_QUEUE_MAX=5000
PIVOT_DB_API_LOG_QUEUE_MAX=5000
PIVOT_DB_MCP_LOG_QUEUE_MAX=5000
PIVOT_DB_USAGE_QUEUE_MAX=5000

# --- GPU 动态负载监控设置 ---
# GPU 指标刷新频率 (单位: 毫秒)
GPU_MONITOR_INTERVAL_MS=15000
# GPU 保护模式下的最低并发限制 (降级时的保底并发)
GPU_CONCURRENT_MIN=1
# GPU 资源充足时的最高并发上限 (锁定最大 2 并发)
GPU_CONCURRENT_MAX=2
# 显存安全阈值：当前常驻最高 92%，设为 0.94，低于此值时维持满载 2 并发
GPU_VRAM_SAFE_THRESHOLD=0.94
# 显存临界阈值：超过此值开始动态下调为 1 并发
GPU_VRAM_CRITICAL_THRESHOLD=0.96
# 显存熔断阈值：超过此值拒绝新请求，保护 2080Ti 显存不爆 OOM 崩溃
GPU_VRAM_REJECT_THRESHOLD=0.98
# 显存恢复阈值：发生熔断后显存回落至此值以下时恢复接收请求
GPU_VRAM_RECOVER_THRESHOLD=0.93

# --- 文档处理 / OCR / PDF 工具配置 ---
# 文档处理产物目录；留空时使用 DATA_DIR/document-processing。本地 Docker 建议随 /app/data 一起持久化。
PIVOT_DOCUMENT_PROCESSING_DIR=
# 默认 OCR 引擎：当前仅支持 http，Pivot 通过 HTTP 对接外部 OCR 项目。
DOCUMENT_PROCESSING_OCR_ENGINE=http
# 外部 OCR 服务客户端配置。OCR 服务由独立项目部署，Pivot 只负责 HTTP 调用。
OCR_SERVICE_URL=http://ocr-service:9100
OCR_SERVICE_HEALTH_TIMEOUT_MS=3000
OCR_SERVICE_MAX_IMAGE_BYTES=52428800
# PDF 渲染页数上限、OCR 页数上限、低置信度复核阈值与 OCR 超时。
DOCUMENT_PROCESSING_MAX_RENDER_PAGES=5
DOCUMENT_PROCESSING_MAX_OCR_PAGES=5
DOCUMENT_PROCESSING_CONFIDENCE_THRESHOLD=0.75
DOCUMENT_PROCESSING_OCR_TIMEOUT_MS=120000
# 文档处理队列并发与输出保留天数。
DOCUMENT_PROCESSING_MAX_CONCURRENT=2
# 文档任务租约与启动恢复参数
DOCUMENT_PROCESSING_JOB_LEASE_MS=900000
DOCUMENT_PROCESSING_RECOVERY_BATCH=100
DOCUMENT_PROCESSING_RECOVERY_INTERVAL_MS=60000
# Office/PDF 二进制解析缓冲区上限
DOCUMENT_MAX_BUFFER_BYTES=268435456
# OCR 外部响应体硬上限
OCR_SERVICE_MAX_RESPONSE_BYTES=16777216
DOCUMENT_PROCESSING_OUTPUT_RETENTION_DAYS=30

# --- 安全与访问策略 ---
# Cookie 安全开关：HTTPS 生产环境建议设置为 true
COOKIE_SECURE=false

# 登录态有效期：Access Token 默认 480 分钟，Refresh Token 默认 30 天
ACCESS_TOKEN_EXPIRES_MINUTES=480
REFRESH_TOKEN_EXPIRES_DAYS=30

# 账号注册策略：首次初始化开放注册默认值；生产环境建议保持 false，之后可由 admin 在“用户管理”页面开关，无需重启
ALLOW_PUBLIC_REGISTRATION=false

# 模型接口准入：是否允许管理员配置内网或本地模型地址 (如 localhost)
ALLOW_PRIVATE_MODEL_URLS=true
# 高风险开关：是否允许模型接口访问敏感内网地址；生产环境建议保持 false
ALLOW_SENSITIVE_OUTBOUND_URLS=false
# 可选：限制模型接口域名白名单，多个域名用英文逗号分隔
MODEL_URL_ALLOWLIST=
# 可选：以逗号分隔的模型端点主机名，这些主机名应被视为此 Pivot 服务器的本地 GPU 节点。
# 适用于通过服务器公网 IP、反向代理主机或 NAT 别名访问本地模型服务的情况。
PIVOT_LOCAL_MODEL_HOSTS=
# 可选：Pivot 对外访问地址或宿主机别名。用于把同服务器部署、但通过内网 IP/域名访问的模型端点识别为本地端点。
PIVOT_ADVERTISE_HOSTS=
# 在 Docker/Kubernetes 环境中，是否将 llama-server 等单标签服务名视为本地模型端点。
# 仅支持该唯一配置项；不读取 Kubernetes 自动变量或旧别名。
PIVOT_TRUST_DOCKER_INTERNAL_HOSTS=false

# 数据库 MCP：允许 SQLite 预设读取的文件根目录，多个目录用英文逗号分隔。
# 留空时仅允许读取 DATA_DIR 下的 SQLite 文件。
MCP_SQLITE_ROOTS=
# 数据库 MCP：允许普通用户连接自己的局域网/本机数据库；设为 true 则仅管理员可配置私有网段数据库主机。
MCP_RESTRICT_PRIVATE_DATABASE_HOSTS_TO_ADMIN=false
# 数据库 MCP：正式查询/工具调用的连接超时时间（毫秒）。
MCP_DATABASE_CONNECT_TIMEOUT_MS=10000
# 数据库 MCP：点击“测试连接”时的快速超时时间（毫秒），避免生产网络丢包时页面长时间等待。
MCP_DATABASE_TEST_TIMEOUT_MS=10000

# --- 管理员与用户初始化策略 ---
# 首次运行且数据库为空时，自动创建的 admin 账号密码；留空则由系统随机生成并写入一次性凭据文件。
# 如需配置，必须至少 8 位且同时包含字母和数字；初始化完成后请删除该变量。
DEFAULT_ADMIN_PASSWORD=

# --- RAG 知识库配置 ---
# 向量化模式：统一使用 http；云端、本机、局域网向量服务都通过 HTTP 接入
EMBEDDING_MODE=http
# 向量化 HTTP 服务接口地址。支持 OpenAI 兼容 /v1/embeddings，也兼容 Ollama /api/embed 或 /api/embeddings
EMBEDDING_API_URL=
# 向量化服务 API Key
EMBEDDING_API_KEY=
# 向量化使用的模型名称
EMBEDDING_MODEL=text-embedding-3-small
# 普通检索向量请求超时 (单位: 毫秒)
EMBEDDING_REQUEST_TIMEOUT_MS=30000
# 文档入库索引向量请求超时 (单位: 毫秒)，大 PDF 或本地向量服务可适当调大
RAG_INDEX_EMBEDDING_TIMEOUT_MS=120000
# 向量化请求并发槽位与自适应动态批处理限制
RAG_EMBEDDING_MAX_CONCURRENCY=2
RAG_EMBEDDING_BATCH_MAX_INPUTS=16
RAG_EMBEDDING_BATCH_MAX_TOKENS=12000
RAG_EMBEDDING_BATCH_MAX_BYTES=524288
# 内存中已解析分块向量缓存上限条目数
RAG_EMBEDDING_CACHE_MAX=5000
# RAG 检索缓存时间 (单位: 毫秒)，设置为 0 表示关闭缓存
RAG_CACHE_TTL_MS=300000
# RAG 检索缓存最大条目数
RAG_CACHE_MAX=1000
# RAG 每次向量重排的候选分片上限，避免大知识库全量内存扫描
RAG_CANDIDATE_LIMIT=300
# RAG 注入上下文的分片数量上限
RAG_TOP_K=3
# RAG 文档分块大小与重叠长度
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
# RAG 后台索引最大并发数
RAG_INDEX_MAX_CONCURRENT=1
# RAG 向量重排命中阈值，分数低于此值的分片不会注入上下文
RAG_SCORE_THRESHOLD=0.4

# --- 核心安全密钥 (生产环境务必修改) ---
# API Key 加密专用密钥。建议填写 32 位以上随机字符串。
# 警告：一旦配置并开始存储模型，请勿随意更改此密钥，否则将无法解密历史 API Key。
DATA_ENCRYPTION_KEY=

# JWT 签名密钥，用于用户登录态验证。建议填写 32 位以上随机字符串。
JWT_SECRET=

# --- 终端安全与隐身模式 ---
# 客户端通信密钥 (Stealth Secret)。用于官方桌面客户端与服务端安全握手
# 开启客户端独占隐身模式后，仅携带此密钥合法签名的客户端可连接访问
PIVOT_STEALTH_SECRET=

# 隐身模式环境变量强制开关。留空默认跟随管理后台设置；true 强制开启；false 强制关闭 (应急恢复访问)
PIVOT_STEALTH_MODE=
