# 智枢 (Pivot AI) 环境变量配置示例
# 注意：生产环境请复制此文件为 .env 并修改关键密钥

# 运行环境：production / development
NODE_ENV=production

# 服务运行端口
PORT=3000

# 跨域白名单，多个地址用英文逗号分隔；同源部署可留空
CORS_ORIGIN=

# 数据目录。Docker 生产环境建议挂载到 /app/data；本地可留空使用项目内 data 目录。
DATA_DIR=

# 记忆压缩 Token 阈值 (推荐设置为模型上下文的 70%)
MEMORY_THRESHOLD=12000

# 响应压缩开关；流式聊天接口不会被压缩
ENABLE_COMPRESSION=true

# 静态资源缓存时间
STATIC_MAX_AGE=1d
VENDOR_STATIC_MAX_AGE=30d

# 运营概览目录体积统计缓存时间，避免频繁扫描大附件目录
DIR_SIZE_CACHE_MS=60000

# Cookie 安全开关：HTTPS 生产环境建议设置为 true
COOKIE_SECURE=false

# 企业账号策略：生产环境建议保持 false，由管理员手动创建账号
ALLOW_PUBLIC_REGISTRATION=false

# 模型接口准入：是否允许管理员配置内网/本地模型地址
ALLOW_PRIVATE_MODEL_URLS=true
# 可选：限制模型接口域名白名单，多个域名用英文逗号分隔
MODEL_URL_ALLOWLIST=

# --- 管理员与用户初始化策略 ---
# 首次运行且数据库为空时，自动创建的 admin 账号密码；留空则由系统随机生成并打印在日志中。
DEFAULT_ADMIN_PASSWORD=
# CSV 批量导入用户时的默认初始密码
DEFAULT_IMPORTED_PASSWORD=pivot123

# --- RAG 知识库配置 (按需开启) ---
ENABLE_RAG=false
EMBEDDING_MODE=cloud
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- 核心安全密钥 (生产环境务必修改) ---
# API Key 加密专用密钥。建议填写 32 位以上随机字符串。
# 警告：一旦配置并开始存储模型，请勿随意更改此密钥，否则将无法解密历史 API Key。
DATA_ENCRYPTION_KEY=your_random_secret_key_for_encryption_at_least_32_chars

# JWT 签名密钥，用于用户登录态验证。建议填写 32 位以上随机字符串。
JWT_SECRET=your_random_jwt_secret_key_at_least_32_chars
